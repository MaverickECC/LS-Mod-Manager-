<Window x:Class="EasyCoop.ModManager.DedicatedServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyCoop Serververwaltung" Icon="Assets/EasyCoop.ico" Width="1120" Height="720" MinWidth="930" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource EasyCoopDark}" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Image Grid.RowSpan="5" Source="Assets/EasyCoop-Background-Servers.png" Stretch="UniformToFill" Opacity="0.20" IsHitTestVisible="False"/>
        <TextBlock Text="FIELDFORGE SERVERVERWALTUNG" FontSize="27" FontWeight="Bold" Foreground="#91D56D" />
        <Border Grid.Row="1" Background="{StaticResource EasyCoopPanel}" CornerRadius="7" Padding="10" Margin="0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ServerUrlBox" Height="34" Margin="4" Padding="7" ToolTip="Dedicated-Server-API-Adresse" />
                <TextBox x:Name="UsernameBox" Grid.Column="1" Height="34" Margin="4" Padding="7" ToolTip="Benutzername" />
                <PasswordBox x:Name="PasswordBox" Grid.Column="2" Height="34" Margin="4" Padding="7" ToolTip="Passwort" />
                <Button x:Name="LoginButton" Grid.Column="3" Content="Anmelden" Click="Login_Click" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource EasyCoopPanel}" CornerRadius="7" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Status aktualisieren" Click="Refresh_Click" />
                    <Button Content="Server neu starten" Background="#A64242" Click="Restart_Click" />
                </StackPanel>
                <ComboBox x:Name="ServersBox" Width="270" Height="34" Margin="4" DisplayMemberPath="Name"
                          HorizontalAlignment="Left" SelectionChanged="ServersBox_SelectionChanged" />
                <TextBlock x:Name="ServerStatusText" Margin="15,0" VerticalAlignment="Center" Foreground="#D4DDD8" />
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="3" x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="#17201B" Foreground="White" RowBackground="#202D26" AlternatingRowBackground="#25342C"
                  BorderThickness="0" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Server" Binding="{Binding ServerVersion}" Width="100" />
                <DataGridTextColumn Header="Lokal" Binding="{Binding LocalVersion}" Width="100" />
                <DataGridTextColumn Header="Vergleich" Binding="{Binding StateText}" Width="125" />
                <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="ActionStatus" Text="Nicht angemeldet" VerticalAlignment="Center" Foreground="#AAB8B0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Auswahl herunterladen" Click="DownloadSelected_Click" />
                <Button Content="Alle Server-Mods synchronisieren" Click="SyncAll_Click" />
                <Button Content="Lokale Mod hochladen" Background="#49624F" Click="Upload_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
