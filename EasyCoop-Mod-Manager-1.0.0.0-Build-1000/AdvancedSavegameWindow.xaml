<Window x:Class="EasyCoop.ModManager.AdvancedSavegameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyCoop – Erweiterter Spielstand-Editor" Icon="Assets/EasyCoop.ico" Width="1120" Height="720" MinWidth="900" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{DynamicResource EasyCoopDark}" Foreground="{DynamicResource EasyCoopText}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
        <Image Grid.RowSpan="3" Source="Assets/EasyCoop-Background-AdvancedSavegame.png" Stretch="UniformToFill" Opacity="0.2" IsHitTestVisible="False"/>
        <Border Background="#E618221D" BorderBrush="{DynamicResource EasyCoopGreen}" BorderThickness="0,0,0,3" Padding="20,12"><DockPanel><Image DockPanel.Dock="Right" Source="{Binding LogoSource}" Width="145" Stretch="Uniform"/><StackPanel><TextBlock Text="ERWEITERTER SPIELSTAND-EDITOR" Foreground="#91D56D" FontWeight="Bold" FontSize="25"/><TextBlock x:Name="Subtitle" Foreground="#C6D2CB" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
        <Grid Grid.Row="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Bereich:" VerticalAlignment="Center" Foreground="#AAB8B0"/><ComboBox x:Name="CategoryBox" Width="180" Height="34" Margin="8,0" SelectionChanged="Category_Changed"><ComboBoxItem Content="Alle"/><ComboBoxItem Content="Fahrzeuge"/><ComboBoxItem Content="Tiere"/><ComboBoxItem Content="Felder"/><ComboBoxItem Content="Produktionen"/></ComboBox><TextBlock Text="Suche:" VerticalAlignment="Center" Foreground="#AAB8B0" Margin="12,0,0,0"/><TextBox x:Name="SearchBox" Width="250" Height="34" Margin="8,0" Padding="7,4" TextChanged="Search_Changed"/></StackPanel>
            <DataGrid Grid.Row="1" x:Name="ValuesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" Background="#E617201B" Foreground="White" RowBackground="#E6202D26" AlternatingRowBackground="#E625342C" CellEditEnding="ValuesGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="Bereich" Binding="{Binding Category}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Objekt" Binding="{Binding ObjectName}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Eigenschaft" Binding="{Binding PropertyName}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Wert" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Quelldatei" Binding="{Binding SourceFile}" IsReadOnly="True" Width="125"/></DataGrid.Columns></DataGrid>
            <Border Grid.Row="2" Background="#D9202D26" CornerRadius="6" Padding="10" Margin="0,10,0,0"><TextBlock Text="Bearbeitet werden nur bekannte, geprüfte XML-Attribute. Vor dem Speichern wird der komplette Spielstand gesichert. Feldbesitz wird über die Besitzer-Farm-ID geändert." TextWrapping="Wrap" Foreground="#C6D2CB"/></Border>
        </Grid>
        <Border Grid.Row="2" Background="#EB0B100D" Padding="14,9"><DockPanel><TextBlock x:Name="StatusText" Foreground="#AAB8B0" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Zurücksetzen" Background="#49624F" Click="Reset_Click"/><Button Content="Änderungen speichern" Click="Save_Click"/><Button Content="Schließen" IsCancel="True" Background="#49554E"/></StackPanel></DockPanel></Border>
    </Grid>
</Window>
