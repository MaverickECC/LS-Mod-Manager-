    <Resource Include="Assets\EasyCoop-Background-Profile.png" />
    <Resource Include="Assets\LS19-Official-Logo.png" />
    <Resource Include="Assets\LS22-Official-Logo.png" />
    <Resource Include="Assets\LS25-Official-Logo.png" />
