    <AssemblyName>EasyCoop Mod Manager</AssemblyName>
    <RootNamespace>EasyCoop.ModManager</RootNamespace>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0+build.1000</InformationalVersion>
    <Product>EasyCoop Mod Manager</Product>
    <Company>EasyCoopClanTV</Company>
    <Copyright>Copyright © EasyCoopClanTV</Copyright>
    <ApplicationIcon>Assets\EasyCoop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
