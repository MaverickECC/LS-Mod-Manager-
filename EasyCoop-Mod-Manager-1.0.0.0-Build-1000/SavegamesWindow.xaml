<Window x:Class="EasyCoop.ModManager.SavegamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyCoop – Spielstände" Icon="Assets/EasyCoop.ico" Width="1120" Height="720" MinWidth="900" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource EasyCoopDark}" Foreground="{DynamicResource EasyCoopText}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Image Grid.RowSpan="3" Source="Assets/EasyCoop-Background-Savegames.png" Stretch="UniformToFill" Opacity="0.20" IsHitTestVisible="False"/>
        <Border Background="#E618221D" BorderBrush="{DynamicResource EasyCoopGreen}" BorderThickness="0,0,0,3" Padding="22,12">
            <DockPanel><Image DockPanel.Dock="Right" Source="{Binding LogoSource}" Width="150" Height="54" Stretch="Uniform"/><StackPanel><TextBlock Text="SPIELSTÄNDE" FontSize="27" FontWeight="Bold" Foreground="#91D56D"/><TextBlock x:Name="GameText" Foreground="#C6D2CB" Margin="0,4,0,0"/></StackPanel></DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="#E61C2822" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ERKANNTE SPIELSTÄNDE" Foreground="#91D56D" FontWeight="Bold" Margin="4,2,4,10"/><DataGrid Grid.Row="1" x:Name="SavegamesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="SavegamesGrid_SelectionChanged" Background="#D917201B" Foreground="White" RowBackground="#E6202D26" AlternatingRowBackground="#E625342C"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding SlotName}" Width="90"/><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Karte" Binding="{Binding MapName}" Width="150"/><DataGridTextColumn Header="Geändert" Binding="{Binding LastModifiedText}" Width="125"/><DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="80"/></DataGrid.Columns></DataGrid></Grid></Border>
            <Border Grid.Column="2" Background="#E61C2822" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="GRUNDWERTE BEARBEITEN" Foreground="#91D56D" FontWeight="Bold" Margin="4,2,4,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Spielstandname" Foreground="#AAB8B0"/><TextBox x:Name="SavegameNameBox" Height="32" Padding="7,4" Margin="0,3,0,7"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Hofname" Foreground="#AAB8B0"/><TextBox x:Name="FarmNameBox" Height="32" Padding="7,4" Margin="0,3,0,7"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Geldbestand" Foreground="#AAB8B0"/><TextBox x:Name="MoneyBox" Height="32" Padding="7,4" Margin="0,3,8,0"/></StackPanel><Button Grid.Column="1" Content="Änderungen speichern" VerticalAlignment="Bottom" Click="SaveValues_Click"/></Grid>
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="BACKUPS DES AUSGEWÄHLTEN SLOTS" Foreground="#91D56D" FontWeight="Bold" Margin="4,0,4,8"/><DataGrid Grid.Row="1" x:Name="BackupsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#D917201B" Foreground="White" RowBackground="#E6202D26" AlternatingRowBackground="#E625342C"><DataGrid.Columns><DataGridTextColumn Header="Sicherung" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedText}" Width="140"/><DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="75"/></DataGrid.Columns></DataGrid></Grid>
                    <TextBlock Grid.Row="4" Text="Vor jeder Bearbeitung und Wiederherstellung wird automatisch ein Backup erstellt." Foreground="#AAB8B0" TextWrapping="Wrap" Margin="4,10,4,2"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#EB0B100D" Padding="14,8"><DockPanel><TextBlock x:Name="StatusText" Text="Bereit" Foreground="#AAB8B0" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Ordner öffnen" Background="#49624F" Click="OpenFolder_Click"/><Button Content="Neu einlesen" Background="#49624F" Click="Refresh_Click"/><Button Content="Erweiterter Editor" Background="#49624F" Click="AdvancedEditor_Click"/><Button Content="Backup erstellen" Click="Backup_Click"/><Button Content="Wiederherstellen" Background="#B56A32" Click="Restore_Click"/><Button Content="Schließen" IsCancel="True" Background="#49554E"/></StackPanel></DockPanel></Border>
    </Grid>
</Window>
