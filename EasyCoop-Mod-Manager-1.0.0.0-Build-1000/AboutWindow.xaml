<Window x:Class="EasyCoop.ModManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über EasyCoop Mod Manager" Icon="Assets/EasyCoop.ico" Width="920" Height="700" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource EasyCoopDark}" Foreground="{DynamicResource EasyCoopText}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image Grid.RowSpan="4" Source="Assets/EasyCoop-Background-About.png" Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False"/>
        <Border Background="#18221D" BorderBrush="{DynamicResource EasyCoopGreen}" BorderThickness="0,0,0,3" Padding="22,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="Assets/EasyCoop-Logo.png" Width="72" Height="72" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="EasyCoop Mod Manager" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Modverwaltung für Landwirtschafts-Simulator 19, 22 und 25" Foreground="#B8C6BE" FontSize="14" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <Border Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="PROGRAMM" Foreground="#91D56D" FontWeight="Bold"/><TextBlock x:Name="VersionText" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="ReleaseText" Foreground="#AAB8B0" Margin="0,3,0,0"/><TextBlock x:Name="ChannelText" Foreground="#AAB8B0" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="ENTWICKLUNG UND HERAUSGABE" Foreground="#91D56D" FontWeight="Bold"/><TextBlock Text="Entwickelt von Maverick" Margin="0,6,0,0"/><TextBlock Text="Herausgegeben von EasyCoopClanTV"/><TextBlock Text="Unabhängiges Community-Projekt" Foreground="#AAB8B0"/></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="EasyCoop unterstützt beim Organisieren, Analysieren, Sichern und Verwalten von Mods. Unterstützt werden LS19, LS22 und LS25 sowie direkte Windows-, Steam-, Epic- und GIANTS-Installationen, sofern die jeweiligen Pfade konfiguriert sind." TextWrapping="Wrap" Margin="4,0,4,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="SYSTEMINFORMATIONEN" Foreground="#91D56D" FontWeight="Bold"/><TextBlock x:Name="SystemText" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="ERKANNTE SPIELE" Foreground="#91D56D" FontWeight="Bold"/><TextBlock x:Name="GamesText" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/></StackPanel></Border>
                </Grid>
                <Border Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel><TextBlock Text="SUPPORT UND KONTAKT" Foreground="#91D56D" FontWeight="Bold"/><TextBlock x:Name="ContactText" TextWrapping="Wrap" Margin="0,7,0,8" Foreground="#AAB8B0"/><WrapPanel><Button x:Name="WebsiteButton" Content="Website öffnen" Click="Website_Click"/><Button x:Name="DiscordButton" Content="Discord öffnen" Click="Discord_Click"/><Button Content="Fehler melden" Click="ReportError_Click"/><Button Content="Diagnosedaten kopieren" Click="CopyDiagnostics_Click"/></WrapPanel></StackPanel>
                </Border>
                <Border Background="#201C18" CornerRadius="8" Padding="16" Margin="0,12,0,0"><TextBlock TextWrapping="Wrap"><Bold>Rechtlicher Hinweis: </Bold>EasyCoop ist ein unabhängiges Community-Projekt und kein offizielles Produkt von GIANTS Software. Landwirtschafts-Simulator und zugehörige Marken sind Eigentum ihrer jeweiligen Rechteinhaber. Copyright © 2026 EasyCoopClanTV. Alle Rechte vorbehalten.</TextBlock></Border>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="18,4" HorizontalAlignment="Center"><Button Content="Änderungsprotokoll" Click="Changelog_Click"/><Button Content="Lizenzinformationen" Click="Licenses_Click"/><Button Content="Datenschutz" Click="Privacy_Click"/></WrapPanel>
        <Border Grid.Row="3" Background="#0B100D" Padding="18,9"><DockPanel LastChildFill="False"><TextBlock x:Name="DatabaseVersionText" Foreground="#91D56D" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Schließen" IsCancel="True" Padding="18,5" Margin="12,0,0,0"/><TextBlock x:Name="FooterVersionText" DockPanel.Dock="Right" Foreground="#AAB8B0" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
</Window>
