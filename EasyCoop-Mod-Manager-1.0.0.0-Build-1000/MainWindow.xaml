<Window x:Class="EasyCoop.ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyCoop Mod Manager" Icon="Assets/EasyCoop.ico" Width="1240" Height="760" MinWidth="980" MinHeight="600"
        Background="{DynamicResource EasyCoopDark}" Foreground="{DynamicResource EasyCoopText}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <ItemsPanelTemplate x:Key="TilePanel"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
        <DataTemplate x:Key="TileModTemplate">
            <Border Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TileWidth}" Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TileHeight}" Margin="7" Padding="10" Background="#D925342C" CornerRadius="7">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#111815" CornerRadius="5" ClipToBounds="True">
                        <Grid><Image Source="Assets/EasyCoop-Logo.png" Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ModImageSize}" Stretch="Uniform" Opacity="0.28" Margin="18"/><Image Source="{Binding IconImage}" Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ModImageSize}" Stretch="UniformToFill"/></Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Row="2" Text="{Binding Author, StringFormat='von {0}'}" Foreground="#AAB8B0" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowAuthor, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Foreground="#D4DDD8" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowVersion, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding StorageStateText}" Foreground="#91D56D" FontWeight="SemiBold" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowStatus, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding AnalysisStatus, StringFormat='Prüfung: {0}'}" Foreground="#AAB8B0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowAnalysis, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ListModTemplate">
            <Border Margin="4" Padding="9" Background="#D925342C" CornerRadius="6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Border Background="#111815" CornerRadius="4" ClipToBounds="True"><Grid><Image Source="Assets/EasyCoop-Logo.png" Opacity="0.25" Margin="12"/><Image Source="{Binding IconImage}" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding FileName}" Foreground="#AAB8B0"/><TextBlock Text="{Binding Author, StringFormat='von {0}'}" Foreground="#AAB8B0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowAuthor, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowVersion, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding SizeText}" Foreground="#AAB8B0"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="{Binding StorageStateText}" Foreground="#91D56D" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowStatus, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding AnalysisStatus}" Foreground="#E49A38" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShowAnalysis, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Image Grid.RowSpan="3" Source="Assets/EasyCoop-Background-Main.png" Stretch="UniformToFill"
               Opacity="0.22" IsHitTestVisible="False" />

        <Border Grid.Row="0" Background="#18221D" BorderBrush="{StaticResource EasyCoopGreen}" BorderThickness="0,0,0,3">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/EasyCoop-Logo.png" Width="62" Height="62" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MOD MANAGEMENT SUITE" FontSize="12" Foreground="#91D56D" FontWeight="SemiBold" />
                    <TextBlock Text="EasyCoop Mod Manager" FontSize="29" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Dedicated Server" Background="#49624F" Click="OpenServers_Click" />
                    <Button Content="Spielstände" Background="#49624F" Click="OpenSavegames_Click" />
                    <Button Content="Spiel starten" Click="StartGame_Click" />
                    <Button Content="Mod installieren" Click="Install_Click" />
                    <Button Content="Mods neu einlesen" Click="Refresh_Click" />
                    <Button Content="Optionen" Background="#49624F" Click="Options_Click" />
                    <Button Content="Über" Background="#49624F" Click="About_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="SPIELVERSIONEN" FontWeight="Bold" Foreground="#91D56D" Margin="6,4,6,12" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="MODPROFILE" FontWeight="Bold" Foreground="#91D56D" Margin="6,0,6,8" />
                        <ComboBox x:Name="ProfilesBox" Height="34" DisplayMemberPath="Name" SelectionChanged="ProfilesBox_SelectionChanged" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="Neu" Click="NewProfile_Click" />
                            <Button Content="Speichern" Click="SaveProfile_Click" />
                            <Button Content="Aktivieren" Click="ActivateProfile_Click" />
                            <Button Content="Löschen" Background="#A64242" Click="DeleteProfile_Click" />
                        </UniformGrid>
                        <TextBlock x:Name="ProfileSummary" Text="Kein Profil ausgewählt" Foreground="#AAB8B0" Margin="6,5,6,0" FontSize="12" />
                        <Separator Margin="4,12" Background="#425148" />
                        <TextBlock Text="MODORDNER" FontWeight="Bold" Foreground="#91D56D" Margin="6,0,6,8" />
                        <ComboBox x:Name="ModFoldersBox" Height="34" DisplayMemberPath="DisplayText"
                                  SelectionChanged="ModFoldersBox_SelectionChanged" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="Hinzufügen" Background="#49624F" Click="ChooseModsPath_Click" />
                            <Button Content="Entfernen" Background="#A64242" Click="RemoveModsPath_Click" />
                        </UniformGrid>
                        <Button Content="Backupordner öffnen" Background="#49624F" Click="OpenBackups_Click" />
                        <Button Content="Spielstart konfigurieren" Background="#49624F" Click="ConfigureGame_Click" />
                        <Button Content="Diagnose exportieren" Background="#49624F" Click="ExportDiagnostics_Click" />
                    </StackPanel>
                    <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" MaxHeight="270"
                             SelectionChanged="GamesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,3" Background="#D925342C" CornerRadius="5" Width="215" MinHeight="66">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding LogoSource}" Width="86" Height="48" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortName}" Foreground="White" FontWeight="Bold" FontSize="15" />
                                            <TextBlock Text="{Binding Status}" Foreground="#AAB8B0" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource EasyCoopPanel}" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="PageTitle" Text="Mods" FontSize="23" FontWeight="Bold" />
                        <TextBlock x:Name="ModCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="#AAB8B0" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="#111815" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STATISTIK" Foreground="#91D56D" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Mods im Ordner" Foreground="#AAB8B0"/><TextBlock x:Name="TotalModsCount" Text="0" FontSize="20" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Aktive Mods" Foreground="#69C846"/><TextBlock x:Name="ActiveModsCount" Text="0" Foreground="#69C846" FontSize="20" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Nicht aktive Mods" Foreground="#E49A38"/><TextBlock x:Name="InactiveModsCount" Text="0" Foreground="#E49A38" FontSize="20" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Warnungen / Fehler" Foreground="#E49A38"/><TextBlock FontSize="20" FontWeight="Bold"><Run x:Name="WarningsCount" Text="0" Foreground="#E49A38"/><Run Text=" / "/><Run x:Name="ErrorsCount" Text="0" Foreground="#E04B4B"/></TextBlock></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock Text="Nicht erkannt" Foreground="#55A8E8"/><TextBlock x:Name="UnknownModsCount" Text="0" Foreground="#55A8E8" FontSize="20" FontWeight="Bold"/></StackPanel>
                        </Grid>
                    </Border>
                    <TextBox Grid.Row="2" x:Name="SearchBox" Height="36" Margin="0,0,0,12" Padding="10,6"
                             TextChanged="SearchBox_TextChanged" ToolTip="Nach Titel, Autor oder Dateiname suchen" />
                    <ListBox Grid.Row="3" x:Name="ModsGrid" Background="#17201B" Foreground="{DynamicResource EasyCoopText}" BorderThickness="0"
                             SelectionMode="Single" SelectionChanged="ModsGrid_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             ItemsPanel="{StaticResource TilePanel}" ItemTemplate="{StaticResource TileModTemplate}"/>
                    <Border Grid.Row="4" Background="#111815" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="PRÜFBERICHT" Foreground="#91D56D" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="AnalysisDetails" Text="Mod auswählen, um den Prüfbericht anzuzeigen."
                                       Foreground="#D4DDD8" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="90" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Aktivieren" Click="Activate_Click" />
                        <Button Content="Deaktivieren" Click="Disable_Click" />
                        <Button Content="In Papierkorb" Background="#A64242" Click="Trash_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B100D">
            <DockPanel Margin="18,0">
                <TextBlock x:Name="StatusText" Text="Bereit" VerticalAlignment="Center" Foreground="#AAB8B0" />
                <TextBlock DockPanel.Dock="Right" Text="Offizielle Version 1.0.0.0 · Build 1000" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#7E8A83" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
